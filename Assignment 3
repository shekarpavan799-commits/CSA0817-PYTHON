# -------------------------------
# 7. PERFORMANCE MEASUREMENT
# -------------------------------
def generate_contacts(n):
    contacts = []
    for i in range(n):
        contacts.append({
            "name": "Person " + str(i),
            "phones": ["9" + str(100000000 + i)],
            "emails": [f"person{i}@gmail.com"]
        })
    return contacts
def benchmark(n):
    contacts = generate_contacts(n)
    tracemalloc.start()
    start = time.perf_counter()
    result = merge_contacts(contacts)
    elapsed = time.perf_counter() - start
    current, peak = tracemalloc.get_traced_memory()
    tracemalloc.stop()
    print("\nContacts:", n)
    print("Merged contacts:", len(result))
    print("Execution time:", round(elapsed, 4), "seconds")
    print("Peak memory:", round(peak / (1024 * 1024), 2), "MB")
print("\nPERFORMANCE TEST")
benchmark(1000)
benchmark(100000)
